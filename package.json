{
  "name": "vice-heist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run prepare:assets && npm run prepare:splash && npm run prepare:menu && npm run validate:assets && npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/src/index.js",
    "prestart": "npm run prepare:assets && npm run prepare:splash && npm run prepare:menu && npm run validate:assets",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test": "npm run build:server && node scripts/test-socket-ack-guard.mjs && node scripts/test-bot-navigation.mjs",
    "prepare:assets": "node scripts/prepare-art-assets.mjs",
    "prepare:splash": "node scripts/prepare-splash-assets.mjs",
    "prepare:menu": "node scripts/prepare-menu-assets.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "pngjs": "^7.0.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@types/pngjs": "^6.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
